# Server Configuration
PORT=8000
HOST=0.0.0.0
BASE_URL=https://your-domain.ngrok-free.app
ENVIRONMENT=development
LOG_LEVEL=INFO

# Plivo Telephony & SMS API
# Get these from https://console.plivo.com/dashboard/
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+12025550143
# For human handoff (must be a verified number on Plivo trial accounts)
HUMAN_HANDOFF_NUMBER=+919876543210

# Speech-To-Text (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Large Language Model (OpenAI / Groq / Any OpenAI-compatible provider)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Text-To-Speech (Deepgram Aura / Streaming TTS)
TTS_MODEL=aura-asteria-en

# Persistence & Retention
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db
TRANSCRIPT_RETENTION_DAYS=30

# Feature Toggles
ENABLE_SMS_CONFIRMATION=true
ENABLE_WEBHOOK_SIGNATURE_VERIFICATION=false
