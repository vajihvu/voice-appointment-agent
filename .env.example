# Server Configuration (binds to localhost by default; no public exposure required)
PORT=8000
HOST=127.0.0.1
BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Browser Voice Transport Security (Optional shared token for /ws/call)
CALL_TOKEN=

# Human Handoff Contact (logged on callback requests)
HUMAN_HANDOFF_CONTACT=+919876543210

# Speech-To-Text (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Large Language Model (OpenAI / Groq / Any OpenAI-compatible provider)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Text-To-Speech (Deepgram Aura / Streaming TTS)
TTS_MODEL=aura-asteria-en

# Persistence & Retention
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db
TRANSCRIPT_RETENTION_DAYS=30

# Feature Toggles
ENABLE_NOTIFICATIONS=true
